@page "/estoque"
@inject ApiClient Api
@inject Avisos Avisos
@inject Sessao Sessao

<div class="cabecalho-pagina">
    <h1>Saldos de estoque</h1>
    <div class="acoes">
        <a class="btn fantasma" href="relatorios">Relatórios e kardex</a>
        @if (Sessao.PodeEstoque) { <a class="btn primario" href="movimentacoes">Lançar entrada / saída</a> }
    </div>
</div>

<div class="filtros cartao">
    <select @bind="depositoId">
        <option value="">Todos os depósitos</option>
        @foreach (var d in depositos) { <option value="@d.Id">@d.Nome</option> }
    </select>
    <input class="largo" placeholder="Produto, SKU ou código de barras" @bind="busca" @onkeydown="@(e => e.Key == "Enter" ? Carregar() : Task.CompletedTask)" />
    <label class="check"><input type="checkbox" @bind="abaixoMinimo" /> Somente abaixo do mínimo</label>
    <label class="check"><input type="checkbox" @bind="agrupar" /> Agrupar por produto</label>
    <button class="btn primario" @onclick="Carregar">Filtrar</button>
</div>

@if (saldos is null)
{
    <div class="carregando"><div class="spinner"></div></div>
}
else
{
    <div class="kpis">
        <div class="kpi"><span>Unidades em estoque</span><strong>@Fmt.Num(saldos.Sum(s => s.Quantidade))</strong></div>
        <div class="kpi"><span>Reservadas (pedidos e transferências)</span><strong>@Fmt.Num(saldos.Sum(s => s.Reservado))</strong></div>
        <div class="kpi"><span>Valor a custo</span><strong>@Fmt.Moeda(saldos.Sum(s => s.Quantidade * s.CustoUnitario))</strong></div>
        <div class="kpi"><span>Linhas abaixo do mínimo</span><strong class="negativo">@saldos.Count(s => s.AbaixoMinimo)</strong></div>
    </div>

    <div class="cartao">
        @if (agrupar)
        {
            <table class="tabela">
                <thead><tr><th>Produto</th>@foreach (var d in DepositosVisiveis) { <th class="num">@d.Nome</th> }<th class="num">Total disp.</th></tr></thead>
                <tbody>
                    @foreach (var g in saldos.GroupBy(s => (s.ProdutoId, s.Produto, s.Sku)))
                    {
                        <tr>
                            <td><strong>@g.Key.Produto</strong><div class="sub">@g.Key.Sku</div></td>
                            @foreach (var d in DepositosVisiveis)
                            {
                                var s = g.FirstOrDefault(x => x.DepositoId == d.Id);
                                <td class="num @(s?.AbaixoMinimo == true ? "negativo" : "")">@(s?.Disponivel.ToString() ?? "—")@(s?.Reservado > 0 ? $" (+{s.Reservado} res.)" : "")</td>
                            }
                            <td class="num"><strong>@g.Sum(x => x.Disponivel)</strong></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <table class="tabela">
                <thead><tr><th>Produto</th><th>Depósito</th><th>Localização</th><th class="num">Físico</th><th class="num">Reservado</th><th class="num">Disponível</th><th class="num">Mínimo</th><th class="num">Valor custo</th></tr></thead>
                <tbody>
                    @foreach (var s in saldos)
                    {
                        <tr>
                            <td><strong>@s.Produto</strong><div class="sub">@s.Sku · @s.Categoria</div></td>
                            <td>@s.Deposito</td>
                            <td>
                                @if (editando == (s.ProdutoId, s.DepositoId))
                                {
                                    <div class="linha">
                                        <input class="mono local" maxlength="20" placeholder="A-01-2" @bind="novaLocalizacao" @onkeydown="@(e => e.Key == "Enter" ? SalvarLocalizacao(s) : Task.CompletedTask)" />
                                        <button class="btn primario pequeno" @onclick="() => SalvarLocalizacao(s)">OK</button>
                                        <button class="btn fantasma pequeno" @onclick="() => editando = null">✕</button>
                                    </div>
                                }
                                else if (Sessao.PodeEstoque)
                                {
                                    <button class="link-botao mono" title="Alterar endereço de armazenagem" @onclick="() => Editar(s)">@(s.Localizacao ?? "definir")</button>
                                }
                                else
                                {
                                    <span class="mono">@(s.Localizacao ?? "—")</span>
                                }
                            </td>
                            <td class="num">@s.Quantidade</td>
                            <td class="num">@s.Reservado</td>
                            <td class="num @(s.AbaixoMinimo ? "negativo" : "")"><strong>@s.Disponivel</strong></td>
                            <td class="num">@s.EstoqueMinimo</td>
                            <td class="num">@Fmt.Moeda(s.Quantidade * s.CustoUnitario)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private List<DepositoDto> depositos = [];
    private List<SaldoDto>? saldos;
    private int? depositoId;
    private string busca = "";
    private bool abaixoMinimo;
    private bool agrupar = true;
    private (int ProdutoId, int DepositoId)? editando;
    private string novaLocalizacao = "";

    private void Editar(SaldoDto s)
    {
        editando = (s.ProdutoId, s.DepositoId);
        novaLocalizacao = s.Localizacao ?? "";
    }

    /// <summary>Endereço de armazenagem (corredor-prateleira-nível): ordena a rota de coleta na ordem de separação.</summary>
    private async Task SalvarLocalizacao(SaldoDto s)
    {
        var valor = string.IsNullOrWhiteSpace(novaLocalizacao) ? null : novaLocalizacao.Trim().ToUpperInvariant();
        try
        {
            await Api.PutSemRespostaAsync("api/estoque/localizacao", new LocalizacaoRequest(s.ProdutoId, s.DepositoId, valor));
            var idx = saldos!.IndexOf(s);
            saldos[idx] = s with { Localizacao = valor };
            editando = null;
        }
        catch (ApiException ex) { Avisos.Erro(ex.Message); }
    }

    private IEnumerable<DepositoDto> DepositosVisiveis => depositos.Where(d => depositoId is null || d.Id == depositoId);

    protected override async Task OnInitializedAsync()
    {
        try { depositos = await Api.GetAsync<List<DepositoDto>>("api/depositos"); }
        catch (ApiException ex) { Avisos.Erro(ex.Message); }
        await Carregar();
    }

    private async Task Carregar()
    {
        try
        {
            var url = $"api/estoque/saldos?abaixoMinimo={abaixoMinimo.ToString().ToLower()}&busca={Uri.EscapeDataString(busca)}";
            if (depositoId is not null) url += $"&depositoId={depositoId}";
            saldos = await Api.GetAsync<List<SaldoDto>>(url);
        }
        catch (ApiException ex) { Avisos.Erro(ex.Message); }
    }
}
