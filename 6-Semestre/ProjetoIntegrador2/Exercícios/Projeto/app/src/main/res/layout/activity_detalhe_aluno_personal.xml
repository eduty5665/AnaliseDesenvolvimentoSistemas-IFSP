<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ui_perfil_do_aluno"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="32dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#2C2C2C"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFotoAlunoDetalhe"
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp"
                    android:contentDescription="@string/profile_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/guerreiro"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

                <TextView android:id="@+id/txtNomeAlunoDetalhe" style="@style/TextAppearance.AppCompat.Body1"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />

                <TextView android:id="@+id/txtCpfAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" android:textColor="#AAAAAA" />

                <TextView android:id="@+id/txtTelefoneAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#AAAAAA" />

                <TextView android:id="@+id/txtSexoAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#AAAAAA" />

                <TextView android:id="@+id/txtIdadeAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#AAAAAA" />

                <TextView android:id="@+id/txtPesoAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#AAAAAA" />

                <TextView android:id="@+id/txtAlturaAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#AAAAAA" />

                <TextView android:id="@+id/txtImcAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#AAAAAA" />

                <TextView android:id="@+id/txtScoreAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="@color/gold"
                    android:textStyle="bold" />

                <TextView android:id="@+id/txtDoencaAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#AAAAAA" />

                <TextView android:id="@+id/txtLesaoAlunoDetalhe"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:textColor="#AAAAAA" />

                <Button
                    android:id="@+id/btnDesvincularAluno"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="28dp"
                    android:backgroundTint="#F44336"
                    android:text="@string/ui_desvincular_aluno"
                    android:textColor="#FFFFFF"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btnVoltarDetalheAluno"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/black"
                    android:text="@string/ui_voltar"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
