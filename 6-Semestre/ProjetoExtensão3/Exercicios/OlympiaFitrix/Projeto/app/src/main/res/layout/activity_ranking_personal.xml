<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <View
        android:id="@+id/headerBackground"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:background="#121212"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtTituloRanking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="150dp"
        android:letterSpacing="0.05"
        android:text="@string/ui_meus_guerreiros"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtSubtituloRanking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_ranking_dos_alunos_vinculados"
        android:textColor="@color/gold"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtTituloRanking" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPodium"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtSubtituloRanking">

        <!-- 2º lugar -->

        <LinearLayout
            android:id="@+id/podiumSecond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/podiumFirst"
            app:layout_constraintStart_toStartOf="parent">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardBackgroundColor="#2C2C2C"
                app:cardCornerRadius="25dp"
                app:strokeColor="#AAAAAA"
                app:strokeWidth="2dp">

                <TextView
                    android:id="@+id/txtShortSecond"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_value__5"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFotoSecond"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/guerreiro"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtNomeSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtScoreSecond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#AAAAAA"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#2C2C2C"
                app:cardCornerRadius="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_value_2"
                    android:textColor="#AAAAAA"
                    android:textSize="20sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- 1º lugar -->

        <LinearLayout
            android:id="@+id/podiumFirst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/podiumThird"
            app:layout_constraintStart_toEndOf="@id/podiumSecond">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="64dp"
                android:layout_height="64dp"
                app:cardBackgroundColor="#2C2C2C"
                app:cardCornerRadius="32dp"
                app:strokeColor="@color/gold"
                app:strokeWidth="3dp">

                <TextView
                    android:id="@+id/txtShortFirst"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_value__6"
                    android:textColor="@color/gold"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFotoFirst"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/guerreiro"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtNomeFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtScoreFirst"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/gold"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="70dp"
                android:layout_height="100dp"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#2C2C2C"
                app:cardCornerRadius="8dp"
                app:strokeColor="@color/gold"
                app:strokeWidth="1dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_value_1"
                    android:textColor="@color/gold"
                    android:textSize="24sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <!-- 3º lugar -->

        <LinearLayout
            android:id="@+id/podiumThird"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/podiumFirst">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="50dp"
                android:layout_height="50dp"
                app:cardBackgroundColor="#2C2C2C"
                app:cardCornerRadius="25dp"
                app:strokeColor="#CD7F32"
                app:strokeWidth="2dp">

                <TextView
                    android:id="@+id/txtShortThird"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_value__7"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgFotoThird"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/profile_photo"
                    android:scaleType="centerCrop"
                    android:src="@drawable/guerreiro"
                    app:shapeAppearanceOverlay="@style/CircleImage" />

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/txtNomeThird"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtScoreThird"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#CD7F32"
                android:textSize="11sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="60dp"
                android:layout_height="40dp"
                android:layout_marginTop="4dp"
                app:cardBackgroundColor="#2C2C2C"
                app:cardCornerRadius="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="@string/ui_value_3"
                    android:textColor="#CD7F32"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- LISTA 4º LUGAR EM DIANTE MANTIDA -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardListaRanking"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#121212"
        app:cardCornerRadius="32dp"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintTop_toBottomOf="@id/layoutPodium">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRanking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="20dp"
            tools:listitem="@layout/item_ranking" />

    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtSemAlunos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_nenhum_aluno_vinculado"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cardListaRanking"
        app:layout_constraintEnd_toEndOf="@id/cardListaRanking"
        app:layout_constraintStart_toStartOf="@id/cardListaRanking"
        app:layout_constraintTop_toTopOf="@id/cardListaRanking" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2C2C2C"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu_personal" />

</androidx.constraintlayout.widget.ConstraintLayout>
