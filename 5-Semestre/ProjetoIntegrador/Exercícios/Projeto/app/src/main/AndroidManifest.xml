<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OlympiaFitrix">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/olympiafitrix" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="solicitacoes_vinculo" />

        <service
            android:name=".service.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <activity
            android:name=".CadastroPerfilActivity"
            android:exported="false" />

        <activity
            android:name=".CadastroActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".AlunoSemPersonalActivity"
            android:exported="false" />

        <activity
            android:name=".RankingActivity"
            android:exported="false" />

        <activity
            android:name=".HistoricoActivity"
            android:exported="false" />

        <activity
            android:name=".PerfilActivity"
            android:exported="false" />

        <activity android:name=".PersonaisActivity" />

        <activity android:name=".DetalhePersonalActivity" />

        <activity android:name=".PersonalHomeActivity" />

        <activity android:name=".RankingPersonalActivity" />

        <activity android:name=".HistoricoPersonalActivity" />

        <activity android:name=".AlunosPersonalActivity" />

        <activity android:name=".DetalheAlunoPersonalActivity" />

        <activity android:name=".PerfilPersonalActivity" />

        <activity android:name=".CriarTreinoActivity" />

        <activity android:name=".ExerciciosListaActivity" />

        <activity android:name=".NiveisListaActivity" />

        <activity android:name=".AtribuirTreinoActivity" />

        <activity android:name=".ExecucaoTreinoActivity" />

    </application>

</manifest>
