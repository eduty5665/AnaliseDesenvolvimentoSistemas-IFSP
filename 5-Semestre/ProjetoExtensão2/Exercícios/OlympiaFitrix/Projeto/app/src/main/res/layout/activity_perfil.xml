<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- TÍTULO -->

    <TextView
        android:id="@+id/txtTituloPerfil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:text="@string/ui_meu_perfil"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/cardPerfil"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <!-- CARD -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardPerfil"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="16dp"
        android:layout_marginHorizontal="10dp"
        app:cardBackgroundColor="#2C2C2C"
        app:cardCornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@id/txtTituloPerfil"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- FOTO -->

                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgFotoPerfil"
                        android:layout_width="88dp"
                        android:layout_height="88dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/profile_photo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/guerreiro"
                        app:shapeAppearanceOverlay="@style/CircleImage" />

                    <ImageButton
                        android:id="@+id/btnAlterarFotoPerfil"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/bg_camera_button"
                        android:contentDescription="@string/change_profile_photo"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera" />

                    <ProgressBar
                        android:id="@+id/progressFotoPerfil"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/gold"
                        android:visibility="gone" />

                </FrameLayout>

                <!-- NOME -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/ui_nome"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilNome"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_nome_completo_2"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- EMAIL -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_email"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_email"
                    android:inputType="textEmailAddress"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- SENHA -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_senha"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#FFFFFF"
                    app:boxBackgroundMode="none">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editPerfilSenha"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint=""
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#AAAAAA" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- CPF -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_cpf"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilCpf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_cpf"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- TELEFONE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_telefone"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilTelefone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_telefone"
                    android:inputType="phone"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- SEXO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_sexo"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <RadioGroup
                    android:id="@+id/radioGroupSexo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/radioMasculino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:buttonTint="#FFFFFF"
                        android:checked="true"
                        android:text="@string/ui_masculino"
                        android:textColor="#FFFFFF" />

                    <RadioButton
                        android:id="@+id/radioFeminino"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:buttonTint="#FFFFFF"
                        android:text="@string/ui_feminino"
                        android:textColor="#FFFFFF" />

                </RadioGroup>

                <!-- IDADE -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_idade"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilIdade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_idade"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- PESO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_peso"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilPeso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_peso_kg"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- ALTURA -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_altura"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilAltura"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_altura_cm"
                    android:inputType="numberDecimal"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_dias_de_treino_por_semana"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilTreinosPlanejadosSemana"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_dias_de_treino_por_semana"
                    android:inputType="number"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- DOENÇA -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_doenca"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilDoenca"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_doenca"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- LESÃO -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/ui_lesao"
                    android:textColor="#AAAAAA"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/editPerfilLesao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#FFFFFF"
                    android:hint="@string/ui_lesao"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#AAAAAA" />

                <!-- BOTÃO -->

                <Button
                    android:id="@+id/btnSalvarPerfil"
                    android:layout_width="match_parent"
                    android:layout_height="55dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="@color/black"
                    android:text="@string/ui_salvar_perfil"
                    android:textColor="#FFFFFF" />

            </LinearLayout>

        </ScrollView>

    </com.google.android.material.card.MaterialCardView>

    <!-- MENU INFERIOR -->

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        app:itemIconTint="@color/white"
        app:itemTextColor="@color/white"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:menu="@menu/bottom_nav_menu" />

</androidx.constraintlayout.widget.ConstraintLayout>
